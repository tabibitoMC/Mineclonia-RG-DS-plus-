+void Hud::drawBottomHotbar()
+{
+	InventoryList *mainlist = inventory->getList("main");
+	if (!mainlist)
+		return;
+	const RgdsUi &ui = g_rgds_ui;
+	const u16 sel = player->getWieldIndex();
+	const s32 n = std::min<s32>({(s32)RgdsUi::SLOTS, (s32)mainlist->getSize(),
+			(s32)player->getMaxHotbarItemcount()});
+
+	// Game-provided hotbar strip and selection frame (same art as on the top screen)
+	if (!player->hotbar_image.empty()) {
+		video::ITexture *tex = tsrc->getTexture(player->hotbar_image);
+		draw2DImageFilterScaled(driver, tex, ui.hotbar,
+				core::rect<s32>(v2s32(0, 0), core::dimension2di(tex->getOriginalSize())),
+				nullptr, hbar_colors, true);
+	} else {
+		for (s32 i = 0; i < n; i++) {
+			core::rect<s32> r = ui.slot[i];
+			driver->draw2DRectangle(video::SColor(255, 40, 40, 40), r);
+			r.UpperLeftCorner += v2s32(3, 3);
+			r.LowerRightCorner -= v2s32(3, 3);
+			driver->draw2DRectangle(video::SColor(255, 139, 139, 139), r);
+		}
+	}
+	for (s32 i = 0; i < n; i++) {
+		const core::rect<s32> &r = ui.slot[i];
+		const s32 inset = r.getWidth() / 7;
+		if (i == sel) {
+			if (!player->hotbar_selected_image.empty()) {
+				video::ITexture *tex = tsrc->getTexture(player->hotbar_selected_image);
+				core::rect<s32> fr = r;
+				fr.UpperLeftCorner -= v2s32(inset / 4, inset / 4);
+				fr.LowerRightCorner += v2s32(inset / 4, inset / 4);
+				draw2DImageFilterScaled(driver, tex, fr,
+						core::rect<s32>(v2s32(0, 0), core::dimension2di(tex->getOriginalSize())),
+						nullptr, hbar_colors, true);
+			} else {
+				const video::SColor c(255, 255, 255, 255);
+				const s32 t = 4;
+				driver->draw2DRectangle(c, core::rect<s32>(r.UpperLeftCorner.X, r.UpperLeftCorner.Y, r.LowerRightCorner.X, r.UpperLeftCorner.Y + t));
+				driver->draw2DRectangle(c, core::rect<s32>(r.UpperLeftCorner.X, r.LowerRightCorner.Y - t, r.LowerRightCorner.X, r.LowerRightCorner.Y));
+				driver->draw2DRectangle(c, core::rect<s32>(r.UpperLeftCorner.X, r.UpperLeftCorner.Y, r.UpperLeftCorner.X + t, r.LowerRightCorner.Y));
+				driver->draw2DRectangle(c, core::rect<s32>(r.LowerRightCorner.X - t, r.UpperLeftCorner.Y, r.LowerRightCorner.X, r.LowerRightCorner.Y));
+			}
+		}
+		core::rect<s32> ir(r.UpperLeftCorner + v2s32(inset, inset),
+				r.LowerRightCorner - v2s32(inset, inset));
+		drawItemStack(driver, g_fontengine->getFont(), mainlist->getItem(i), ir, nullptr,
+				client, i == sel ? IT_ROT_SELECTED : IT_ROT_NONE);
+	}
+}

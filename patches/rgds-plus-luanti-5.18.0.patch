+
+// ---------------------------------------------------------------------------
+// [RG DS Plus] Dual screen support.
+// The main window lives on the top display. A second fullscreen GL window is
+// opened on the bottom display and shares the same GL context, so the engine
+// can draw the GUI (inventory, menus, chat) there every frame.
+// Env vars: LUANTI_DUALSCREEN=0 disables it, LUANTI_TOP_DISPLAY / LUANTI_BOTTOM_DISPLAY
+// choose the SDL display indices (defaults 0 / 1).
+// ---------------------------------------------------------------------------
+#ifdef RGDS_EVDEV
+// [RG DS Plus] evdev touchscreen (implementation in rgds_evdev.cpp)
+void CIrrDeviceSDL::setupEvdevTouch()
+{
+	TouchFd = rgds_touch_open([](const char *msg, bool warn) {
+		os::Printer::log(msg, warn ? ELL_WARNING : ELL_INFORMATION);
+	});
+}
+
+void CIrrDeviceSDL::pollEvdevTouch()
+{
+	if (TouchFd < 0)
+		return;
+	rgds_touch_poll([this](int slot, int type, float nx, float ny) {
+		SEvent e;
+		e.EventType = EET_TOUCH_INPUT_EVENT;
+		e.TouchInput.Event = type == 0 ? ETIE_PRESSED_DOWN :
+				(type == 1 ? ETIE_MOVED : ETIE_LEFT_UP);
+		e.TouchInput.ID = slot;
+		e.TouchInput.X = (s32)(nx * Width);
+		e.TouchInput.Y = (s32)(ny * Height);
+		if (type == 0)
+			CurrentTouchCount++;
+		e.TouchInput.touchedCount = CurrentTouchCount;
+		if (type == 2 && CurrentTouchCount > 0)
+			CurrentTouchCount--;
+		postEventFromUser(e);
+	});
+}
+
+void CIrrDeviceSDL::emitEvdevTouch(int, ETOUCH_INPUT_EVENT) {}
+#endif
+
+#ifndef _IRR_USE_SDL3_
+void CIrrDeviceSDL::setupDualScreen()
+{
+	CurrentTarget = Window;
+	const int n = SDL_GetNumVideoDisplays();
+	{
+		char buf[256];
+		snprintf(buf, sizeof(buf), "[dualscreen] SDL video driver: %s, displays: %d",
+				SDL_GetCurrentVideoDriver() ? SDL_GetCurrentVideoDriver() : "?", n);
+		os::Printer::log(buf, ELL_INFORMATION);
+		for (int i = 0; i < n; i++) {
+			SDL_Rect r{};
+			SDL_GetDisplayBounds(i, &r);
+			SDL_DisplayMode m{};
+			SDL_GetCurrentDisplayMode(i, &m);
+			snprintf(buf, sizeof(buf), "[dualscreen] display %d '%s': bounds %d,%d %dx%d mode %dx%d@%d",
+					i, SDL_GetDisplayName(i) ? SDL_GetDisplayName(i) : "?",
+					r.x, r.y, r.w, r.h, m.w, m.h, m.refresh_rate);
+			os::Printer::log(buf, ELL_INFORMATION);
+		}
+	}
+	const char *en = getenv("LUANTI_DUALSCREEN");
+	if (en && en[0] == '0') {
+		os::Printer::log("[dualscreen] disabled by LUANTI_DUALSCREEN=0", ELL_INFORMATION);
+		return;
+	}
+	// LUANTI_DUALSCREEN_TEST=1: desktop testing, bottom window placed to the right
+	const char *tst = getenv("LUANTI_DUALSCREEN_TEST");
+	const bool test_mode = tst && tst[0] == '1' && n < 2;
+	if (n < 2 && !test_mode) {
+		os::Printer::log("[dualscreen] only one display found, running single screen", ELL_WARNING);
+		return;
+	}
+	int bottom = (TopDisplay == 0) ? 1 : 0;
+	if (const char *e = getenv("LUANTI_BOTTOM_DISPLAY"))
+		bottom = atoi(e);
+	if (test_mode)
+		bottom = TopDisplay;
+	else if (bottom < 0 || bottom >= n || bottom == TopDisplay) {
+		os::Printer::log("[dualscreen] invalid bottom display", ELL_WARNING);
+		return;
+	}
+
+	u32 flags = SDL_WINDOW_OPENGL | SDL_WINDOW_BORDERLESS;
+	if (CreationParams.Fullscreen)
+		flags |= SDL_WINDOW_FULLSCREEN_DESKTOP;
+	SDL_Rect b{};
+	SDL_GetDisplayBounds(bottom, &b);
+	// Same pixel size as the main window, so GUI coordinates match 1:1.
+	int w = Width ? (int)Width : b.w, h = Height ? (int)Height : b.h;
+	if (test_mode) {
+		flags = SDL_WINDOW_OPENGL | SDL_WINDOW_BORDERLESS;
+		SDL_SetWindowPosition(Window, 0, 0);
+		Window2 = SDL_CreateWindow("Luanti bottom", w, 0, w, h, flags);
+	} else {
+		Window2 = SDL_CreateWindow("Luanti bottom", SDL_WINDOWPOS_CENTERED_DISPLAY(bottom),
+				SDL_WINDOWPOS_CENTERED_DISPLAY(bottom), w, h, flags);
+	}
+	if (!Window2) {
+		os::Printer::log("[dualscreen] could not create bottom window", SDL_GetError(), ELL_WARNING);
+		return;
+	}
+	if (SDL_GL_MakeCurrent(Window2, Context) != 0) {
+		os::Printer::log("[dualscreen] cannot share GL context with bottom window", SDL_GetError(), ELL_WARNING);
+		SDL_DestroyWindow(Window2);
+		Window2 = nullptr;
+		SDL_GL_MakeCurrent(Window, Context);
+		return;
+	}
+	// Don't wait for vblank twice per frame.
+	SDL_GL_SetSwapInterval(0);
+	SDL_GL_MakeCurrent(Window, Context);
+	SDL_RaiseWindow(Window);
+	int w2, h2;
+	SDL_GL_GetDrawableSize(Window2, &w2, &h2);
+	char buf[160];
+	snprintf(buf, sizeof(buf), "[dualscreen] bottom window on display %d, %dx%d (top %ux%u)",
+			bottom, w2, h2, Width, Height);
+	os::Printer::log(buf, ELL_INFORMATION);
+}
+
+bool CIrrDeviceSDL::beginSecondScreen()
+{
+	if (!Window2)
+		return false;
+	if (SDL_GL_MakeCurrent(Window2, Context) != 0)
+		return false;
+	CurrentTarget = Window2;
+	return true;
 }
 
+void CIrrDeviceSDL::endSecondScreen()
+{
+	if (!Window2)
+		return;
+	SDL_GL_MakeCurrent(Window, Context);
+	CurrentTarget = Window;
+}
+#else
+void CIrrDeviceSDL::setupDualScreen() {}
+bool CIrrDeviceSDL::beginSecondScreen() { return false; }
+void CIrrDeviceSDL::endSecondScreen() {}
+#endif

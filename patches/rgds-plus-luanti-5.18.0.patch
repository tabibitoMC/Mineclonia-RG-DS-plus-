 					DIR_DELIM .. "pack" .. DIR_DELIM
 
+-- [RG DS Plus] Minecraft-style theme for every main menu formspec
+do
+	local d = defaulttexturedir
+	local function esc(p) return core.formspec_escape(p) end
+	local theme = table.concat({
+		"bgcolor[#00000088;false]",
+		"style_type[button;bgimg=", esc(d .. "rgds_btn.png"),
+		";bgimg_hovered=", esc(d .. "rgds_btn_hover.png"),
+		";bgimg_pressed=", esc(d .. "rgds_btn_pressed.png"),
+		";bgimg_middle=8;border=false;textcolor=#E0E0E0]",
+		"style_type[field,pwdfield,textarea;textcolor=#FFFFFF]",
+		"style_type[label;textcolor=#FFFFFF]",
+		"style_type[tabheader;textcolor=#E0E0E0]",
+	})
+	local header_el = {formspec_version = true, size = true, position = true, anchor = true,
+		padding = true, no_prepend = true, real_coordinates = true, allow_close = true}
+	local function apply(fs)
+		if type(fs) ~= "string" or fs == "" then return fs end
+		local pos = 1
+		while true do
+			local s, e, name = fs:find("^%s*([%w_]+)%[[^%]]*%]", pos)
+			if s and header_el[name] then pos = e + 1 else break end
+		end
+		return fs:sub(1, pos - 1) .. theme .. fs:sub(pos)
+	end
+	local update_formspec = core.update_formspec
+	core.update_formspec = function(fs) return update_formspec(apply(fs)) end
+end
+

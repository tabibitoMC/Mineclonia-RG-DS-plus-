+// [RG DS Plus] Gamepad navigation for every formspec (main menu, inventory,
+// pause menu...): D-pad/stick move the focus, A accepts, B goes back,
+// L1/R1 switch tabs. In the game itself the same buttons control the camera.
+static void rgds_send_key(EKEY_CODE key, bool down, bool shift = false, bool ctrl = false)
+{
+	SEvent ev{};
+	ev.EventType = EET_KEY_INPUT_EVENT;
+	ev.KeyInput.Key = key;
+	ev.KeyInput.Char = key == KEY_SPACE ? L' ' : 0;
+	ev.KeyInput.SystemKeyCode = 0;
+	ev.KeyInput.PressedDown = down;
+	ev.KeyInput.Shift = shift;
+	ev.KeyInput.Control = ctrl;
+	if (auto *dev = RenderingEngine::get_raw_device())
+		dev->postEventFromUser(ev);
+}
+
+bool GUIFormSpecMenu::rgdsGamepad(const SEvent &event)
+{
+	enum Nav { NONE, UP, DOWN, LEFT, RIGHT };
+	Nav nav = NONE;
+	if (event.EventType == EET_GAMEPAD_AXIS_EVENT) {
+		// Stick works like the D-pad (edge triggered)
+		static int last_x = 0, last_y = 0;
+		const auto &a = event.GamepadAxisEvent;
+		const int v = a.Value > 20000 ? 1 : (a.Value < -20000 ? -1 : 0);
+		if (a.Axis == GamepadAxis::LEFTX) {
+			if (v != last_x && v != 0) nav = v > 0 ? RIGHT : LEFT;
+			last_x = v;
+		} else if (a.Axis == GamepadAxis::LEFTY) {
+			if (v != last_y && v != 0) nav = v > 0 ? DOWN : UP;
+			last_y = v;
+		} else {
+			return false;
+		}
+		if (nav == NONE)
+			return true;
+	} else if (event.EventType == EET_GAMEPAD_BUTTON_EVENT) {
+		const auto &b = event.GamepadButtonEvent;
+		switch (b.Button) {
+		case GamepadButton::DPAD_UP: nav = UP; break;
+		case GamepadButton::DPAD_DOWN: nav = DOWN; break;
+		case GamepadButton::DPAD_LEFT: nav = LEFT; break;
+		case GamepadButton::DPAD_RIGHT: nav = RIGHT; break;
+		case GamepadButton::EAST: { // A: accept / press
+			gui::IGUIElement *f = Environment->getFocus();
+			const bool text = f && (f->getType() == gui::EGUIET_EDIT_BOX ||
+					f->getType() == gui::EGUIET_TABLE);
+			rgds_send_key(text ? KEY_RETURN : KEY_SPACE, b.PressedDown);
+			return true;
+		}
+		case GamepadButton::SOUTH: // B: back
+			if (b.PressedDown) {
+				rgds_send_key(KEY_ESCAPE, true);
+				rgds_send_key(KEY_ESCAPE, false);
+			}
+			return true;
+		case GamepadButton::LEFT_SHOULDER:
+		case GamepadButton::RIGHT_SHOULDER:
+			if (b.PressedDown) {
+				const bool prev = b.Button == GamepadButton::LEFT_SHOULDER;
+				rgds_send_key(KEY_TAB, true, prev, true);
+				rgds_send_key(KEY_TAB, false, prev, true);
+			}
+			return true;
+		case GamepadButton::NORTH:
+		case GamepadButton::WEST:
+			return true; // unused in menus
+		default:
+			return false; // START / SELECT keep their normal meaning
+		}
+		if (!b.PressedDown)
+			return true;
+	} else {
+		return false;
+	}
+
+	// Up/Down move inside lists and dropdowns, otherwise they move the focus
+	gui::IGUIElement *f = Environment->getFocus();
+	const bool listy = f && isMyDescendant(f) &&
+			(f->getType() == gui::EGUIET_TABLE || f->getType() == gui::EGUIET_LIST_BOX ||
+			f->getType() == gui::EGUIET_COMBO_BOX);
+	if ((nav == UP || nav == DOWN) && listy) {
+		const EKEY_CODE k = nav == UP ? KEY_UP : KEY_DOWN;
+		rgds_send_key(k, true);
+		rgds_send_key(k, false);
+	} else {
+		const bool back = nav == UP || nav == LEFT;
+		rgds_send_key(KEY_TAB, true, back);
+		rgds_send_key(KEY_TAB, false, back);
+	}
+	return true;
+}
